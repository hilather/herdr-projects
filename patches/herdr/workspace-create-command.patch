+        id: String,
+        params: crate::api::schema::WorkspaceCreateCommandParams,
+    ) -> String {
+        if let Err(message) = validate_workspace_command(&params) {
+            return encode_error(id, "invalid_workspace_command", message);
+        }
+        let extra_env = match super::env::normalize_launch_env(params.env) {
