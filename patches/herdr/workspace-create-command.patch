+
+fn validate_workspace_command(
+    params: &crate::api::schema::WorkspaceCreateCommandParams,
+) -> Result<(), &'static str> {
+    if !std::path::Path::new(&params.cwd).is_absolute()
+        || params.cwd.len() > 4096
+        || params.cwd.contains('\0')
+    {
+        return Err("workspace command requires an absolute bounded working directory");
+    }
+    if params.command.is_empty()
+        || params.command.len() > 160
+        || !std::path::Path::new(&params.command[0]).is_absolute()
+        || params.command.iter().any(|arg| arg.contains('\0'))
+        || params.command.iter().map(String::len).sum::<usize>() > 65536
+    {
+        return Err(
+            "workspace command requires bounded literal arguments and an absolute executable",
+        );
+    }
+    Ok(())
+}
