+#[test]
+fn workspace_create_command_is_a_distinct_literal_method() {
+    let json = serde_json::json!({"id":"create-command", "method":"workspace.create_command",
+        "params":{"cwd":"/tmp", "command":["/usr/bin/sleep", "1"], "focus":false}});
+    let request: Request = serde_json::from_value(json.clone()).unwrap();
+    assert!(matches!(request.method, Method::WorkspaceCreateCommand(_)));
+    assert_eq!(serde_json::to_value(&request).unwrap(), json);
+    let mut invalid = json;
+    invalid["params"].as_object_mut().unwrap().remove("command");
+    assert!(serde_json::from_value::<Request>(invalid).is_err());
+}
+
+#[test]
+fn workspace_command_capability_is_optional_and_explicit() {
+    let old=serde_json::json!({"live_handoff":false});
+    let mut caps:ServerCapabilities=serde_json::from_value(old).unwrap();
+    assert!(!caps.workspace_create_command);
+    assert!(serde_json::to_value(&caps).unwrap().get("workspace_create_command").is_none());
+    caps.workspace_create_command=true;
+    assert_eq!(serde_json::to_value(caps).unwrap()["workspace_create_command"],true);
+}
