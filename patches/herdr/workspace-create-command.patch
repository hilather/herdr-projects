+#[cfg(test)]
+mod workspace_command_tests {
+    use super::*;
+    #[test]
+    fn workspace_command_requires_explicit_execution_and_never_falls_back_to_shell() {
+        let mut params = crate::api::schema::WorkspaceCreateCommandParams {
+            cwd: std::env::temp_dir().display().to_string(),
+            command: vec![
+                std::env::current_exe().unwrap().display().to_string(),
+                "literal ' $(not-a-command)".into(),
+            ],
+            focus: false,
+            label: None,
+            env: Default::default(),
+        };
+        assert!(validate_workspace_command(&params).is_ok());
+        let args = params.command.clone();
+        for invalid in [
+            vec![],
+            vec!["relative".into()],
+            vec![args[0].clone(), "bad\0argument".into()],
+            vec![args[0].clone(); 161],
+        ] {
+            params.command = invalid;
+            assert!(validate_workspace_command(&params).is_err());
+        }
+        params.command = args;
+        params.cwd = "relative".into();
+        assert!(validate_workspace_command(&params).is_err());
+    }
+}
