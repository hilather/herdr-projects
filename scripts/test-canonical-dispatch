#!/usr/bin/env python3
"""Build and run the disposable controller-to-native-fixture acceptance test."""
import json
import os
from pathlib import Path
import subprocess
import sys

if sys.platform != "linux":
    raise SystemExit("Canonical dispatch acceptance requires Linux pidfs and namespaces.")
root = Path(__file__).resolve().parent.parent
build = subprocess.run(
    ["cargo", "test", "--locked", "--offline", "--features", "state-store",
     "--lib", "--bin", "herdr-projects", "--no-run", "--message-format=json"],
    cwd=root, stdout=subprocess.PIPE, text=True,
)
executables = {}
for line in build.stdout.splitlines():
    message = json.loads(line)
    if message.get("reason") == "compiler-message":
        rendered = message.get("message", {}).get("rendered")
        if rendered:
            print(rendered, file=sys.stderr, end="")
    if message.get("reason") != "compiler-artifact" or not message.get("executable"):
        continue
    if not message.get("profile", {}).get("test"):
        continue
    for kind, source in [("library", root / "src/lib.rs"), ("driver", root / "src/main.rs")]:
        if Path(message["target"]["src_path"]).resolve() == source:
            executables[kind] = message["executable"]
if build.returncode:
    raise SystemExit(build.returncode)
if set(executables) != {"library", "driver"}:
    raise SystemExit("Cargo did not provide both test executables.")
environment = os.environ.copy()
environment["HP_CONTROLLER_TEST_BINARY"] = executables["driver"]
for test in [
    "enabled_controller_queue_launches_cancels_and_preserves_across_projects",
    "enabled_ticker_launches_and_preserves_with_shared_root_maintenance",
]:
    result = subprocess.run(
        [executables["library"], "--exact", "canonical_worker::tests::" + test,
         "--ignored", "--nocapture", "--test-threads=1"],
        cwd=root, env=environment,
    )
    if result.returncode:
        raise SystemExit(result.returncode)
