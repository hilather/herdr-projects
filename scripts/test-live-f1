#!/usr/bin/env python3
"""F1.7 acceptance: a live worker result is verified and integrated automatically,
and a dependent launches on the integrated SHA. `--dry-run` plays both workers
with fixtures; a live run needs explicit authorization."""
import argparse
import json
import os
from pathlib import Path
import subprocess
import sys

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--herdr', type=Path)
parser.add_argument('--agent', type=Path, help='Resolved Codex executable (not a version-manager shim).')
parser.add_argument('--auth-file', type=Path)
parser.add_argument('--dry-run', action='store_true', help='Stand-in Herdr and agent; the harness writes the workers\' files. No real agent, login or Herdr server.')
parser.add_argument('--allow-authenticated-workflow', action='store_true',
                    help='Authorize temporary login use and two short worker sessions in a disposable project; may consume account usage.')
args = parser.parse_args()
if sys.platform != 'linux':
    parser.error('This acceptance test requires Linux pidfs and namespaces.')
environment = os.environ.copy()
if args.dry_run:
    environment['HP_LIVE_F1_MODE'] = 'fixture'
else:
    if not args.allow_authenticated_workflow:
        parser.error('Explicit --allow-authenticated-workflow is required (or --dry-run).')
    if not (args.herdr and args.agent and args.auth_file):
        parser.error('--herdr, --agent and --auth-file are required for a live run.')
    paths = {name: getattr(args, name).absolute() for name in ('herdr', 'agent', 'auth_file')}
    for name, path in paths.items():
        if path.is_symlink() or not path.is_file():
            parser.error(f'{name} must name a regular non-symlink file.')
        if name != 'auth_file' and not os.access(path, os.X_OK):
            parser.error(f'{name} must be executable.')
    # Never display or parse credential contents.
    metadata = paths['auth_file'].stat()
    if metadata.st_mode & 0o077 or metadata.st_size > 256 * 1024:
        parser.error('Authentication file must be private and at most 256 KiB.')
    environment.update(HP_LIVE_F1_MODE='live', HP_LIVE_HERDR=str(paths['herdr']),
                       HP_LIVE_AGENT=str(paths['agent']), HP_LIVE_AUTH_FILE=str(paths['auth_file']))
root = Path(__file__).resolve().parent.parent
build = subprocess.run(
    ['cargo', 'test', '--release', '--locked', '--offline', '--features', 'state-store',
     '--test', 'cli', '--no-run', '--message-format=json'],
    cwd=root, stdout=subprocess.PIPE, text=True,
)
executable = None
for line in build.stdout.splitlines():
    message = json.loads(line)
    if message.get('reason') == 'compiler-message':
        rendered = message.get('message', {}).get('rendered')
        if rendered:
            print(rendered, file=sys.stderr, end='')
    if message.get('reason') == 'compiler-artifact' and message.get('executable') \
            and message.get('target', {}).get('name') == 'cli':
        executable = message['executable']
if build.returncode:
    raise SystemExit(build.returncode)
if not executable:
    raise SystemExit('Cargo did not provide the cli test executable.')
result = subprocess.run(
    [executable, '--exact', 'live_f1_worker_result_integrates_and_dependent_launches_on_integrated_sha',
     '--ignored', '--nocapture', '--test-threads=1'], cwd=root, env=environment,
)
raise SystemExit(result.returncode)
